#!/usr/bin/env bash
# pre-commit — Scan staged files for API keys/secrets before committing.
#
# Installed automatically by init-code-forge.sh (points git at the submodule copy):
#   git config core.hooksPath code-forge-team-common/hooks/git
#
# Rule engine lives in ../lib/secret-scan.js — the SAME module the PreToolUse hook
# (dangerous-op-blocker.js) uses, so a secret is judged identically whether it is
# written by Claude or committed from a plain terminal. Do not re-implement rules here.
#
# Applies to: everyone committing to this repo (human and Claude alike).

set -uo pipefail

HOOK_DIR=$(cd "$(dirname "$0")" && pwd)
SCANNER="$HOOK_DIR/../lib/secret-scan.js"

# Không có node / thiếu scanner → cảnh báo và cho commit đi tiếp (không chặn việc
# của dev vì lý do môi trường). PreToolUse hook vẫn che phần Claude ghi ra.
if ! command -v node >/dev/null 2>&1; then
  echo "⚠️  pre-commit: không tìm thấy 'node' → BỎ QUA quét secret." >&2
  exit 0
fi
if [ ! -f "$SCANNER" ]; then
  echo "⚠️  pre-commit: không thấy $SCANNER → BỎ QUA quét secret." >&2
  echo "   Chạy: git submodule update --init code-forge-team-common" >&2
  exit 0
fi

# Only look at added/modified files (skip deletions — D — and renames — R)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMT 2>/dev/null) || true
[ -z "$STAGED_FILES" ] && exit 0

FOUND=0

report() { # $1=file  $2=multi-line reason from scanner
  if [ "$FOUND" -eq 0 ]; then
    echo ""
    echo "🚫 BLOCKED: Potential secrets found in staged files."
    echo ""
  fi
  echo "   File   : $1"
  # $2 nhiều dòng → thụt lề từng dòng cho khớp cột
  printf '%s\n' "$2" | while IFS= read -r l; do echo "   $l"; done
  echo ""
  FOUND=1
}

while IFS= read -r file; do
  [ -z "$file" ] && continue
  # Chỉ lấy dòng THÊM MỚI trong diff; cut -c2- bỏ dấu '+' đầu dòng.
  ADDED=$(git diff --cached -- "$file" 2>/dev/null | grep '^+' | grep -v '^+++' | cut -c2- || true)
  [ -z "$ADDED" ] && continue

  if out=$(printf '%s\n' "$ADDED" | node "$SCANNER" --file "$file"); then
    : # sạch
  else
    rc=$?
    if [ "$rc" -eq 1 ]; then
      report "$file" "$out"
    else
      echo "⚠️  pre-commit: secret-scan lỗi (rc=$rc) trên '$file' → bỏ qua file này." >&2
    fi
  fi
done <<< "$STAGED_FILES"

if [ "$FOUND" -ne 0 ]; then
  echo "   Action : Remove secrets; use environment variables or .env (gitignored)."
  echo "            For config, use an env reference like \${DB_PASSWORD} WITHOUT a hardcoded default."
  echo "   Bắt nhầm? Thêm '# forge:allow-secret' vào cuối dòng đó."
  echo "   Review : git diff --cached"
  exit 1
fi

exit 0
