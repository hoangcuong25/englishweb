datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  STUDENT
  ADMIN
}

enum Language {
  VI
  EN
  ZH
  JA
}

enum CourseCategory {
  IELTS
  BUSINESS
  KIDS
  PEDAGOGY
  LIFE_SKILLS
}

enum MaterialType {
  PDF
  AUDIO
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  FILL_BLANK
}

enum WritingTaskType {
  TASK_1
  TASK_2
}

enum WritingSubmissionStatus {
  DRAFT
  SUBMITTED
  AI_EVALUATED
  APPROVED
}

enum RoomStatus {
  SCHEDULED
  ACTIVE
  ENDED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
}

enum SubmissionStatus {
  PENDING
  GRADED
}

// ==========================================
// 1. AUTH & USER MANAGEMENT (MÔ-ĐUN 1 & 2)
// ==========================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  fullName      String
  phone         String?
  role          Role      @default(STUDENT)
  isActive      Boolean   @default(true)
  avatarUrl     String?
  preferredLang Language  @default(VI)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  refreshTokens            RefreshToken[]
  googleAccount            GoogleAccount?
  enrollments              Enrollment[]
  lessonProgresses         LessonProgress[]
  quizSubmissions          QuizSubmission[]
  studentWritingSubmits    WritingSubmission[]   @relation("StudentWritingSubmissions")
  adminApprovedWritings    WritingSubmission[]   @relation("AdminApprovedWritings")
  speakingSubmissions      SpeakingSubmission[]  @relation("StudentSpeakingSubmissions")
  gradedSpeakings          SpeakingSubmission[]  @relation("AdminGradedSpeakings")
  hostedRooms              Classroom[]           @relation("HostRooms")
  attendanceRecords        AttendanceRecord[]
  conversationsAsStudent   Conversation[]        @relation("StudentConversations")
  conversationsAsAdmin     Conversation[]        @relation("AdminConversations")
  sentMessages             Message[]             @relation("SentMessages")

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  token      String    @unique @db.VarChar(500)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String?
  ipAddress  String?
  userAgent  String?   @db.Text
  isRevoked  Boolean   @default(false)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model GoogleAccount {
  id         String   @id @default(uuid())
  googleId   String   @unique
  email      String
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("google_accounts")
}

// ==========================================
// 2. LMS & DIGITAL LIBRARY (MÔ-ĐUN 3 & 4)
// ==========================================

model Course {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  description String?        @db.Text
  category    CourseCategory @default(IELTS)
  thumbnail   String?
  isPublished Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  modules     CourseModule[]
  enrollments Enrollment[]
  classrooms  Classroom[]

  @@map("courses")
}

model CourseModule {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id              String         @id @default(uuid())
  moduleId        String
  module          CourseModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  description     String?        @db.Text
  orderIndex      Int            @default(0)
  durationMinutes Int            @default(45)
  videoUrl        String?
  isFreePreview   Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  materials        Material[]
  quizzes          Quiz[]
  speakingPrompts  SpeakingPrompt[]
  writingPrompts   WritingPrompt[]
  lessonProgresses LessonProgress[]

  @@index([moduleId])
  @@map("lessons")
}

model Material {
  id              String       @id @default(uuid())
  lessonId        String
  lesson          Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title           String
  type            MaterialType @default(PDF)
  fileKey         String
  fileSize        Int?
  durationSeconds Int?
  isPrivate       Boolean      @default(true)
  isWatermarked   Boolean      @default(true)
  createdAt       DateTime     @default(now())

  @@index([lessonId])
  @@map("materials")
}

model Enrollment {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPercent Float    @default(0)
  enrolledAt      DateTime @default(now())

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progresses")
}

// ==========================================
// 3. AI WRITING ASSESSMENT (MÔ-ĐUN 6)
// ==========================================

model WritingPrompt {
  id               String          @id @default(uuid())
  lessonId         String?
  lesson           Lesson?         @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title            String
  taskType         WritingTaskType @default(TASK_2)
  topic            String          @db.Text
  targetWords      Int             @default(250)
  timeLimitMinutes Int             @default(40)
  sampleEssay      String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  submissions      WritingSubmission[]

  @@index([lessonId])
  @@map("writing_prompts")
}

model WritingSubmission {
  id                     String                  @id @default(uuid())
  promptId               String
  prompt                 WritingPrompt           @relation(fields: [promptId], references: [id], onDelete: Cascade)
  userId                 String
  user                   User                    @relation("StudentWritingSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  content                String                  @db.Text
  wordCount              Int                     @default(0)
  timeSpentSeconds       Int                     @default(0)
  status                 WritingSubmissionStatus @default(SUBMITTED)
  overallBand            Float?
  taskAchievementScore   Float?
  coherenceCohesionScore Float?
  lexicalResourceScore   Float?
  grammarScore           Float?
  aiFeedback             String?                 @db.Text
  aiSuggestions          Json?
  sampleBand8Essay       String?                 @db.Text
  adminFeedback          String?                 @db.Text
  adminOverrideBand      Float?
  approvedAt             DateTime?
  approvedById           String?
  approvedBy             User?                   @relation("AdminApprovedWritings", fields: [approvedById], references: [id], onDelete: SetNull)
  submittedAt            DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([promptId])
  @@index([userId])
  @@index([approvedById])
  @@map("writing_submissions")
}

// ==========================================
// 4. SPEAKING STUDIO (MÔ-ĐUN 7)
// ==========================================

model SpeakingPrompt {
  id             String   @id @default(uuid())
  lessonId       String?
  lesson         Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title          String
  topic          String?  @db.Text
  sampleAudioUrl String?
  minSeconds     Int      @default(30)
  maxSeconds     Int      @default(120)
  createdAt      DateTime @default(now())

  submissions    SpeakingSubmission[]

  @@index([lessonId])
  @@map("speaking_prompts")
}

model SpeakingSubmission {
  id                 String           @id @default(uuid())
  promptId           String
  prompt             SpeakingPrompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  userId             String
  user               User             @relation("StudentSpeakingSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  audioUrl           String
  durationSeconds    Int              @default(0)
  status             SubmissionStatus @default(PENDING)
  bandScore          Float?
  fluencyScore       Float?
  lexicalScore       Float?
  grammarScore       Float?
  pronunciationScore Float?
  feedback           String?          @db.Text
  timestampFeedback  Json?
  gradedAt           DateTime?
  gradedById         String?
  gradedBy           User?            @relation("AdminGradedSpeakings", fields: [gradedById], references: [id], onDelete: SetNull)
  submittedAt        DateTime         @default(now())

  @@index([promptId])
  @@index([userId])
  @@index([gradedById])
  @@map("speaking_submissions")
}

// ==========================================
// 5. QUIZ ENGINE (MÔ-ĐUN 8)
// ==========================================

model Quiz {
  id               String   @id @default(uuid())
  lessonId         String
  lesson           Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title            String
  description      String?  @db.Text
  timeLimitMinutes Int      @default(15)
  passScore        Float    @default(80)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  questions   Question[]
  submissions QuizSubmission[]

  @@index([lessonId])
  @@map("quizzes")
}

model Question {
  id          String       @id @default(uuid())
  quizId      String
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  content     String       @db.Text
  type        QuestionType @default(SINGLE_CHOICE)
  points      Float        @default(1.0)
  explanation String?      @db.Text
  orderIndex  Int          @default(0)

  options QuestionOption[]
  answers QuizAnswer[]

  @@index([quizId])
  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  isCorrect  Boolean  @default(false)

  answers QuizAnswer[]

  @@index([questionId])
  @@map("question_options")
}

model QuizSubmission {
  id             String   @id @default(uuid())
  quizId         String
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score          Float
  totalQuestions Int
  correctAnswers Int
  isPassed       Boolean  @default(false)
  submittedAt    DateTime @default(now())

  answers QuizAnswer[]

  @@index([quizId])
  @@index([userId])
  @@map("quiz_submissions")
}

model QuizAnswer {
  id               String          @id @default(uuid())
  submissionId     String
  submission       QuizSubmission  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)
  textAnswer       String?         @db.Text
  isCorrect        Boolean         @default(false)

  @@index([submissionId])
  @@index([questionId])
  @@map("quiz_answers")
}

// ==========================================
// 6. LIVEKIT WEBRTC & ATTENDANCE (MÔ-ĐUN 5 & 9)
// ==========================================

model Classroom {
  id                 String     @id @default(uuid())
  name               String
  courseId           String?
  course             Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  hostId             String
  host               User       @relation("HostRooms", fields: [hostId], references: [id], onDelete: Cascade)
  scheduledStartTime DateTime
  scheduledEndTime   DateTime
  actualStartTime    DateTime?
  actualEndTime      DateTime?
  status             RoomStatus @default(SCHEDULED)
  createdAt          DateTime   @default(now())

  attendanceRecords AttendanceRecord[]

  @@index([courseId])
  @@index([hostId])
  @@map("classrooms")
}

model AttendanceRecord {
  id               String           @id @default(uuid())
  classroomId      String
  classroom        Classroom        @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  studentId        String
  student          User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  firstJoinedAt    DateTime?
  lastLeftAt       DateTime?
  totalMinutes     Int              @default(0)
  status           AttendanceStatus @default(ABSENT)
  isManualOverride Boolean          @default(false)
  note             String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([classroomId, studentId])
  @@index([classroomId])
  @@index([studentId])
  @@map("attendance_records")
}

// ==========================================
// 7. REALTIME CHAT & MESSAGING (MÔ-ĐUN 11)
// ==========================================

model Conversation {
  id            String    @id @default(uuid())
  studentId     String
  student       User      @relation("StudentConversations", fields: [studentId], references: [id], onDelete: Cascade)
  adminId       String
  admin         User      @relation("AdminConversations", fields: [adminId], references: [id], onDelete: Cascade)
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages      Message[]

  @@unique([studentId, adminId])
  @@index([studentId])
  @@index([adminId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  isRead         Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}
