{
  "name": "englishweb",
  "version": "1.0.0",
  "description": "Website Dạy Tiếng Anh Trực Tuyến (LMS & LiveKit WebRTC SFU)",
  "private": true,
  "scripts": {
    "dev:server": "cd server && npm run start:dev",
    "dev:client": "cd client && npm run dev",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "prisma:generate": "cd server && npm run prisma:generate",
    "prisma:migrate": "cd server && npm run prisma:migrate",
    "prisma:seed": "cd server && npm run prisma:seed",
    "test:e2e": "cd server && npm run test:e2e",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "english",
    "lms",
    "webrtc",
    "livekit",
    "nestjs",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "docx": "^9.15.3"
  }
}
